# Site Configuration
NEXT_PUBLIC_SITE_URL=https://munroe-island.in

# WhatsApp Dispatch Number
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Direct Dynamic UPI Configuration (Personal or Business UPI)
NEXT_PUBLIC_UPI_ID=your_upi_id@bank
NEXT_PUBLIC_UPI_NAME="Your Name"

# Razorpay Payment Gateway (Optional)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database Connection (Neon / Supabase PostgreSQL)
DATABASE_URL=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email Service (Nodemailer SMTP: e.g. Gmail App Password, Brevo, Resend, or AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM="Munroe Island Expeditions <no-reply@munroe-island.in>"
ADMIN_EMAIL=your-admin-notification-email@gmail.com

# Admin Dashboard Security Passcode
ADMIN_PASSCODE=
