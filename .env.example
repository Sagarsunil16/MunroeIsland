# Site Configuration
NEXT_PUBLIC_SITE_URL=https://munroe-island.in

# Official WhatsApp Dispatch Number
NEXT_PUBLIC_WHATSAPP_NUMBER=919995685136

# Direct Dynamic UPI Configuration (No business/MSME registration required)
NEXT_PUBLIC_UPI_ID=your_upi_id@bank
NEXT_PUBLIC_UPI_NAME="Munroe Island Waterways"

# Razorpay Payment Gateway (Optional)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database Connection (Neon / Supabase PostgreSQL)
DATABASE_URL=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email Service (Nodemailer SMTP: e.g. Gmail App Password, Brevo, Resend, or AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM="Munroe Island Expeditions <no-reply@munroe-island.in>"
ADMIN_EMAIL=your-admin-notification-email@gmail.com

# Admin Dashboard Security Passcode
ADMIN_PASSCODE=munroe2026
